{
  "$id": "tunnel/goaway-payload.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "shutdown",
        "rebalance",
        "replaced"
      ]
    },
    "graceMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "reason",
    "graceMs"
  ]
}
