{
  "$id": "assertion/source-jws-claims.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "aud": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "iss",
    "iat",
    "exp",
    "jti",
    "aud"
  ]
}
