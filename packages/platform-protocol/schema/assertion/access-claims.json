{
  "$id": "assertion/access-claims.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "sub": {
      "type": "string",
      "minLength": 1
    },
    "aud": {
      "type": "string",
      "const": "cloud"
    },
    "sid": {
      "type": "string",
      "minLength": 1
    },
    "ver": {
      "type": "number",
      "const": 1
    }
  },
  "required": [
    "iss",
    "iat",
    "exp",
    "jti",
    "sub",
    "aud",
    "sid",
    "ver"
  ]
}
