{
  "$id": "assertion/ed25519-public-jwk.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kty": {
      "type": "string",
      "const": "OKP"
    },
    "crv": {
      "type": "string",
      "const": "Ed25519"
    },
    "x": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "kid": {
      "type": "string"
    },
    "alg": {
      "type": "string",
      "const": "EdDSA"
    },
    "use": {
      "type": "string",
      "const": "sig"
    }
  },
  "required": [
    "kty",
    "crv",
    "x"
  ]
}
