{
  "$id": "assertion/tunnel-token-claims.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "sub": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "aud": {
      "type": "string",
      "const": "relay-tunnel"
    },
    "cnf": {
      "type": "object",
      "properties": {
        "jwk": {
          "type": "object",
          "properties": {
            "kty": {
              "type": "string",
              "const": "OKP"
            },
            "crv": {
              "type": "string",
              "const": "Ed25519"
            },
            "x": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "kid": {
              "type": "string"
            },
            "alg": {
              "type": "string",
              "const": "EdDSA"
            },
            "use": {
              "type": "string",
              "const": "sig"
            }
          },
          "required": [
            "kty",
            "crv",
            "x"
          ]
        }
      },
      "required": [
        "jwk"
      ]
    },
    "ver": {
      "type": "number",
      "const": 1
    },
    "org": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "iss",
    "iat",
    "exp",
    "jti",
    "sub",
    "aud",
    "cnf",
    "ver"
  ]
}
