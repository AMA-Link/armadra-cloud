{
  "$id": "assertion/relay-token-claims.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "sub": {
      "type": "string",
      "minLength": 1
    },
    "aud": {
      "type": "string",
      "const": "relay"
    },
    "src": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "ver": {
      "type": "number",
      "const": 1
    },
    "team": {
      "type": "string",
      "minLength": 1
    },
    "ro": {
      "type": "boolean"
    },
    "dev": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "iss",
    "iat",
    "exp",
    "jti",
    "sub",
    "aud",
    "src",
    "ver"
  ]
}
