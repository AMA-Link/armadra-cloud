{
  "name": "@armadra/platform-protocol",
  "version": "0.9.0",
  "description": "Armadra 平台协议：隧道帧、断言声明、/v1 契约、错误码与身份参数",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AMA-Link/armadra-cloud.git",
    "directory": "packages/platform-protocol"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tunnel": {
      "types": "./dist/tunnel/index.d.ts",
      "default": "./dist/tunnel/index.js"
    },
    "./assertion": {
      "types": "./dist/assertion/index.d.ts",
      "default": "./dist/assertion/index.js"
    },
    "./cloud-api": {
      "types": "./dist/cloud-api/index.d.ts",
      "default": "./dist/cloud-api/index.js"
    },
    "./core-api": {
      "types": "./dist/core-api/index.d.ts",
      "default": "./dist/core-api/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./identity-vectors": {
      "types": "./dist/identity-vectors/index.d.ts",
      "default": "./dist/identity-vectors/index.js"
    },
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "default": "./dist/e2e/index.js"
    },
    "./http1": {
      "types": "./dist/http1/index.d.ts",
      "default": "./dist/http1/index.js"
    },
    "./ws-frames": {
      "types": "./dist/ws-frames/index.d.ts",
      "default": "./dist/ws-frames/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "default": "./dist/fixtures/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "fixtures",
    "schema"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fixtures": "node scripts/gen-fixtures.ts",
    "fixtures:check": "node scripts/gen-fixtures.ts --check",
    "schema": "node scripts/gen-schema.ts",
    "schema:check": "node scripts/gen-schema.ts --check"
  },
  "peerDependencies": {
    "zod": ">=4.0.0 <5"
  },
  "dependencies": {
    "@orpc/contract": "1.15.4"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
