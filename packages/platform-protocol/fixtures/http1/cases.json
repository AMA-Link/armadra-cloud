{
  "$comment": "HTTP/1.1 线上字节（隧道流里 core 写回的响应、中继写进去的请求）。体写成 text（UTF-8）、hex 或 { length, fill }；error 是本仓实现的分类，其他实现只要求报错。",
  "responses": [
    {
      "name": "content-length",
      "method": "GET",
      "expect": {
        "version": "1.1",
        "status": 200,
        "statusText": "OK",
        "headers": [
          [
            "Content-Type",
            "text/plain; charset=utf-8"
          ],
          [
            "Content-Length",
            "5"
          ],
          [
            "Set-Cookie",
            "a=1"
          ],
          [
            "set-cookie",
            "b=2"
          ]
        ],
        "body": {
          "text": "hello"
        },
        "upgrade": false,
        "needsEof": false
      },
      "file": "http1/response-content-length.bin"
    },
    {
      "name": "chunked",
      "method": "GET",
      "expect": {
        "version": "1.1",
        "status": 200,
        "statusText": "OK",
        "headers": [
          [
            "content-type",
            "application/json"
          ],
          [
            "transfer-encoding",
            "chunked"
          ]
        ],
        "body": {
          "text": "{\"ok\":true,\"items\":[]}"
        },
        "upgrade": false,
        "needsEof": false
      },
      "file": "http1/response-chunked.bin"
    },
    {
      "name": "close-delimited",
      "method": "GET",
      "expect": {
        "version": "1.0",
        "status": 200,
        "statusText": "OK",
        "headers": [
          [
            "content-type",
            "text/event-stream"
          ]
        ],
        "body": {
          "text": "data: 1\n\ndata: 2\n\n"
        },
        "upgrade": false,
        "needsEof": true
      },
      "file": "http1/response-close-delimited.bin"
    },
    {
      "name": "head",
      "method": "HEAD",
      "expect": {
        "version": "1.1",
        "status": 200,
        "statusText": "OK",
        "headers": [
          [
            "content-length",
            "1048576"
          ]
        ],
        "body": {
          "text": ""
        },
        "upgrade": false,
        "needsEof": false
      },
      "file": "http1/response-head.bin"
    },
    {
