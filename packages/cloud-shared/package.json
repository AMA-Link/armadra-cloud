{
  "name": "@armadra/cloud-shared",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "armadra-cloud 内部共享：日志、JWS 校验、中继自有页面、PostgreSQL 客户端（不发布）",
  "exports": {
    "./log": "./src/log.ts",
    "./db": "./src/db/client.ts",
