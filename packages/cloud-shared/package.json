{
  "name": "@armadra/cloud-shared",
  "version": "0.3.10",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "armadra-cloud 内部共享：配置、日志、健康检查、极小 HTTP、JWS 校验、中继自有页面、PostgreSQL 与 Redis 客户端（不发布）",
  "exports": {
    "./config": "./src/config.ts",
    "./log": "./src/log.ts",
    "./health": "./src/health.ts",
    "./http": "./src/http/index.ts",
    "./db": "./src/db/client.ts",
    "./redis": "./src/redis.ts",
    "./jwt": "./src/jwt.ts",
    "./pages": "./src/pages.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@armadra/platform-protocol": "workspace:*",
    "postgres": "3.4.9",
    "redis": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
