  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@armadra/cloud-shared": "workspace:*",
    "@armadra/platform-protocol": "workspace:*",
    "@armadra/relay-kernel": "workspace:*",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
