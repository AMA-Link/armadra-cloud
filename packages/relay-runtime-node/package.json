{
  "name": "@armadra/relay-runtime-node",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "中继的 Node 运行时：ws 隧道终端、边缘的 HTTP / WebSocket 字节进出、clientIp、HTTP 分派与 startRelay（装配 relay-kernel，不发布）",
  "exports": {
    "./*": "./src/*.ts",
    "./testing/*": "./test/*.ts"
