{
  "name": "@armadra/e2e-fake-core",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "端到端用的假 core（Node http + ws 的隧道客户端），给 scripts/e2e 的 saas 与 saas-nodes 模式连中继用（不发布）",
  "exports": {
