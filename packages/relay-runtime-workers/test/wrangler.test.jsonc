// 测试用的 Worker 配置（vitest 的 Workers 插件按它起 workerd，本地运行，不连 Cloudflare 账号）。
// secret 都是只在测试里用的值。
{
  "name": "armadra-relay-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "Text", "globs": ["**/*.sql", "**/*.txt"], "fallthrough": true },
  ],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "durable_objects": {
    "bindings": [
      { "name": "SOURCE", "class_name": "SourceDO" },
      { "name": "CONTROL", "class_name": "ControlDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SourceDO", "ControlDO"] },
  ],
  "ratelimits": [
    {
      "name": "LIMIT_LOGIN",
      "namespace_id": "9001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "LIMIT_TUNNEL",
      "namespace_id": "9004",
      "simple": { "limit": 1000, "period": 60 },
    },
  ],
  "vars": {
    "RELAY_MODE": "personal",
    "RELAY_ISSUER": "https://relay.armadra.test",
    "RELAY_NAME": "Test relay",
    "RELAY_TRUSTED_ORIGINS": "https://app.armadra.test",
    "RELAY_MASTER_KEY": "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    "RELAY_METRICS_TOKEN": "test-metrics-token",
    "RELAY_PERSONAL_ACCOUNT": "owner",
    "RELAY_PERSONAL_PASSWORD": "plover-quartz-lantern-41",
    "RELAY_LOG_LEVEL": "error",
  },
}
