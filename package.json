{
  "name": "armadra-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "libs:build": "pnpm --filter @armadra/platform-protocol build",
    "check": "pnpm libs:build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm repo:check && pnpm contract:check && pnpm protocol:check && pnpm ci:workflows && pnpm notices:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm libs:build && pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "repo:check": "node tools/repo-check.mjs",
    "repo:test": "node --test tools/*.test.mjs tools/ci/*.test.mjs tools/contract/*.test.mjs",
    "contract:check": "node tools/contract/generate.mjs --check",
    "contract:generate": "node tools/contract/generate.mjs",
    "protocol:check": "pnpm --filter @armadra/platform-protocol fixtures:check && node scripts/gen-vectors.mjs --check",
    "protocol:pack": "node scripts/pack-protocol.mjs",
    "ci:workflows": "node tools/ci/validate-workflows.mjs",
    "notices": "node tools/notices.mjs",
    "notices:check": "node tools/notices.mjs --check",
    "knip": "knip --no-progress --no-exit-code",
    "dev:up": "sh scripts/dev.sh up",
    "dev:down": "sh scripts/dev.sh down",
    "dev": "pnpm libs:build && node scripts/dev-run.mjs",
    "db:migrate": "node --env-file-if-exists=.env.dev apps/cloud/src/cli.ts migrate",
    "relay:personal": "pnpm libs:build && node scripts/relay-personal.mjs",
    "build": "pnpm -r --if-present build",
    "images:build": "docker build -f apps/cloud/Dockerfile -t armadra-cloud:local . && docker build -f apps/relay/Dockerfile -t armadra-relay:local .",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@armadra/platform-protocol": "workspace:*",
    "@eslint/js": "9.39.5",
    "@orpc/openapi": "1.15.4",
    "@orpc/zod": "1.15.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "knip": "6.39.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "ws": "8.21.0",
    "zod": "4.4.3"
  }
}
