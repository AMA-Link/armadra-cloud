{
  "name": "armadra-cloud",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node tools/hooks/install.mjs",
    "libs:build": "pnpm --filter @armadra/platform-protocol build",
    "check": "node tools/ci/check-ci.mjs --no-repo-test",
    "check:ci": "node tools/ci/check-ci.mjs",
    "verify": "node tools/ci/verify.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettier-cache",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm libs:build && pnpm -r --if-present test",
    "go:check": "node scripts/go-check.mjs",
    "repo:check": "node tools/repo-check.mjs",
    "repo:test": "node --test tools/*.test.mjs tools/ci/*.test.mjs tools/contract/*.test.mjs scripts/*.test.mjs tools/hooks/*.test.mjs",
    "contract:check": "node tools/contract/generate.mjs --check",
    "contract:generate": "node tools/contract/generate.mjs",
    "protocol:check": "pnpm --filter @armadra/platform-protocol fixtures:check && pnpm --filter @armadra/platform-protocol schema:check && node scripts/gen-vectors.mjs --check",
    "protocol:pack": "node scripts/pack-protocol.mjs",
    "ci:workflows": "node tools/ci/validate-workflows.mjs",
    "notices": "node tools/notices.mjs",
    "notices:check": "node tools/notices.mjs --check",
    "knip": "knip --no-progress --no-exit-code",
    "dev:up": "sh scripts/dev.sh up",
    "dev:down": "sh scripts/dev.sh down",
    "dev": "pnpm libs:build && node scripts/dev-run.mjs",
    "db:migrate": "node scripts/dev-cloud.mjs migrate",
    "relay:personal": "node scripts/relay-personal.mjs",
    "build": "pnpm -r --if-present build",
    "images:build": "node scripts/build-images.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@armadra/platform-protocol": "workspace:*",
    "@eslint/js": "10.0.1",
    "@orpc/openapi": "1.16.2",
    "@orpc/zod": "1.16.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  }
}
