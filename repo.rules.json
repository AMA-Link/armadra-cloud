{
  "$comment": "仓库结构规则，由 tools/repo-check.mjs 执行（与 Armadra 同一份实现，差异只在本文件）。",
  "root": [
    ".dockerignore",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".npmrc",
    ".prettierignore",
    "AGENTS.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "deploy",
    "docs",
    "eslint.config.js",
    "go",
    "knip.json",
    "migrations.lock",
    "package.json",
    "packages",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "repo.rules.json",
    "scripts",
    "tools",
    "tsconfig.base.json"
  ],
  "blacklist": [
    "dist/",
    "out/",
    "coverage/",
    ".data/",
    ".idea/",
    ".env",
    ".env.dev",
    "*.tgz",
    ".dev.vars",
    ".wrangler/",
    ".terraform/",
    "*.tfstate",
    "*.tfvars"
  ],
  "docs": {
    "root": "docs",
    "index": "docs/README.md",
    "directoryOnly": ["runbooks"]
  },
  "links": {
    "include": ["*.md", "deploy/", "docs/", "packages/", "tools/"],
    "exclude": []
  },
  "naming": [
    {
      "directory": "packages",
      "manifest": "package.json",
      "prefix": "@armadra/"
    }
  ],
  "fileSize": {
    "max": 1500,
    "roots": ["packages", "tools", "scripts", "go"],
    "extensions": [".ts", ".mts", ".mjs", ".js", ".go"],
    "excludeSegments": ["/node_modules/", "go/internal/protocol/gen/"],
    "exemptions": []
  },
  "migrations": {
    "lock": "migrations.lock",
    "$comment": "两个迁移目录各自从 0001 连续，都在 Go 模块里、是唯一来源：PostgreSQL（cloud 与 Go 中继 --store postgres / --control postgres 共用）与 SQLite（Go 中继 --store sqlite）；lock 守住已发布迁移的字节。",
    "sources": [
      {
        "path": "go/internal/store/postgres/migrations",
        "kind": "directory"
      },
      {
        "path": "go/internal/store/sqlite/migrations",
        "kind": "directory"
      }
    ]
  },
  "pinnedVersions": [
    {
      "$comment": "接口层 oRPC 1.15.4 精确锁：只能写精确版本、不得预发布、全树同一版本。",
      "packages": "@orpc/*"
    }
  ],
  "goModules": [
    {
      "$comment": "go/ 只许 import 标准库、本模块与这里登记的第三方模块：x/crypto 给 scrypt；x/net/idna 给入参解释器的 format: uri（IDN 主机名转 punycode）；gorilla/websocket 给隧道与 me-stream 的升级；modernc.org/sqlite（纯 Go，连同它的传递依赖）与 pgx/v5（连同 puddle、x/sync 等）是存储驱动；go-redis/v9（连同 xxhash 等）是多节点控制面的 Redis 驱动；jsonschema（及它的 x/text）只在测试里校验 cloud-api 夹具，不进生产代码。go.mod 的版本都写精确版本，不用 replace。internal/core 不碰数据面（tunnel、edge），延续「控制核不碰中继内核」的边界。",
      "root": "go",
      "allow": [
        "github.com/cespare/xxhash/v2",
        "github.com/dustin/go-humanize",
        "github.com/google/uuid",
        "github.com/gorilla/websocket",
        "github.com/jackc/pgpassfile",
        "github.com/jackc/pgservicefile",
        "github.com/jackc/pgx/v5",
        "github.com/jackc/puddle/v2",
        "github.com/mattn/go-isatty",
        "github.com/ncruces/go-strftime",
        "github.com/redis/go-redis/v9",
        "github.com/remyoudompheng/bigfft",
        "github.com/santhosh-tekuri/jsonschema/v6",
        "go.uber.org/atomic",
        "golang.org/x/crypto",
        "golang.org/x/net",
        "golang.org/x/sync",
        "golang.org/x/sys",
        "golang.org/x/text",
        "modernc.org/libc",
        "modernc.org/mathutil",
        "modernc.org/memory",
        "modernc.org/sqlite"
      ],
      "testOnly": ["github.com/santhosh-tekuri/jsonschema/v6"],
      "testOnlyPackages": ["internal/testutil"],
      "internalBoundaries": [
        {
          "from": "internal/core",
          "forbid": ["internal/tunnel", "internal/edge", "internal/cloud"]
        },
        {
          "from": "internal/store",
          "forbid": ["internal/cloud"]
        },
        {
          "from": "internal/control",
          "forbid": ["internal/cloud"]
        },
        {
          "$comment": "SaaS 控制面不碰数据面与个人中转：客户端 IP 的取法在 internal/clientip，两边共用。",
          "from": "internal/cloud",
          "forbid": [
            "internal/tunnel",
            "internal/edge",
            "internal/netpoll",
            "internal/dataplane",
            "internal/personal"
          ]
        }
      ],
      "onlyImportedBy": [
        {
          "$comment": "TeamScope 只能在 teams.Require 里、核过成员与角色之后构造（SaaS 实施设计 §4.11）；store/saas 用类型别名转出，测试不受限。",
          "package": "internal/store/saas/teamscope",
          "allow": ["internal/cloud/teams", "internal/store/saas"]
        }
      ]
    }
  ],
  "packageDependencies": [
    {
      "$comment": "协议包两仓共用、页面与手机直接用：不依赖本仓任何包。",
      "package": "packages/platform-protocol",
      "forbid": ["@armadra/e2e-fake-core"]
    },
    {
      "$comment": "假 core 只给 scripts/e2e 用：只依赖协议包与 ws，不带 PostgreSQL / Redis 与 oRPC。",
      "package": "packages/e2e-fake-core",
      "forbid": ["postgres", "redis", "@orpc/*"]
    }
  ]
}
