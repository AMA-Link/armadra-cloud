{
  "$comment": "仓库结构规则，由 tools/repo-check.mjs 执行（与 Armadra 同一份实现，差异只在本文件）。",
  "root": [
    ".dockerignore",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".npmrc",
    ".prettierignore",
    "AGENTS.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "apps",
    "deploy",
    "docs",
    "eslint.config.js",
    "knip.json",
    "migrations.lock",
    "package.json",
    "packages",
    "patches",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "repo.rules.json",
    "scripts",
    "tools",
    "tsconfig.base.json"
  ],
  "blacklist": [
    "dist/",
    "out/",
    "coverage/",
    ".data/",
    ".idea/",
    ".env",
    ".env.dev",
    "*.tgz"
  ],
  "docs": {
    "root": "docs",
    "index": "docs/README.md",
    "directoryOnly": ["runbooks"]
  },
  "links": {
    "include": ["*.md", "apps/", "deploy/", "docs/", "packages/", "tools/"],
    "exclude": []
  },
  "naming": [
    {
      "directory": "packages",
      "manifest": "package.json",
      "prefix": "@armadra/"
    },
    {
      "directory": "apps",
      "manifest": "package.json",
      "prefix": "@armadra/"
    }
  ],
  "fileSize": {
    "max": 1500,
    "roots": ["apps", "packages", "tools", "scripts"],
    "extensions": [".ts", ".mts", ".mjs", ".js"],
    "excludeSegments": ["/node_modules/"],
    "exemptions": []
  },
  "migrations": {
    "lock": "migrations.lock",
    "$comment": "两个迁移目录各自从 0001 连续：PostgreSQL（cloud）与 SQLite（Node 中继 --store sqlite 与 DO SQLite 共用）；lock 守住已发布迁移的字节。",
    "sources": [
      {
        "path": "apps/cloud/src/db/migrations",
        "kind": "directory"
      },
      {
        "path": "packages/control-store-sql/migrations",
        "kind": "directory"
      }
    ]
  },
  "pinnedVersions": [
    {
      "$comment": "接口层 oRPC 1.15.4 精确锁：只能写精确版本、不得预发布、全树同一版本。",
      "packages": "@orpc/*"
    }
  ],
  "packageDependencies": [
    {
      "$comment": "中继内核是 personal 与 saas 共用的数据面：不依赖控制核与 app，不带 SaaS 专有依赖（PostgreSQL / Redis），也不带 oRPC。",
      "package": "packages/relay-kernel",
      "forbid": [
        "@armadra/control-core",
        "@armadra/cloud",
        "@armadra/relay",
        "postgres",
        "redis",
        "@orpc/*"
      ]
    },
    {
      "$comment": "控制核只经端口读写状态、与传输无关：不依赖中继内核、app、存储客户端与 WebSocket。",
      "package": "packages/control-core",
      "forbid": [
        "@armadra/relay-kernel",
        "@armadra/cloud",
        "@armadra/relay",
        "postgres",
        "redis",
        "ws"
      ]
    },
    {
      "$comment": "SQLite 存储只实现控制核的端口（node:sqlite）：不依赖中继内核、app 与别的存储客户端。",
      "package": "packages/control-store-sqlite",
      "forbid": [
        "@armadra/relay-kernel",
        "@armadra/cloud",
        "@armadra/relay",
        "postgres",
        "redis",
        "ws",
        "better-sqlite3",
        "sqlite3"
      ]
    },
    {
      "$comment": "SQL 包只放迁移与账本判定（Node 与 DO 共用）：不依赖本仓任何包。",
      "package": "packages/control-store-sql",
      "forbid": [
        "@armadra/cloud-shared",
        "@armadra/control-core",
        "@armadra/control-store-sqlite",
        "@armadra/relay-kernel",
        "@armadra/cloud",
        "@armadra/relay"
      ]
    },
    {
      "$comment": "协议包两仓共用、页面与手机直接用：不依赖本仓任何包。",
      "package": "packages/platform-protocol",
      "forbid": [
        "@armadra/cloud-shared",
        "@armadra/control-core",
        "@armadra/relay-kernel",
        "@armadra/cloud",
        "@armadra/relay"
      ]
    }
  ]
}
