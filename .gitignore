.DS_Store
.idea/
.vscode/

node_modules/
.pnpm-store/
dist/
out/
coverage/
*.tgz

# 本地开发：dev.sh 生成的口令与密钥、开发数据目录
.env
.env.*
!.env.example
.data/
# Workers 中继：wrangler dev 的本地 secret 与状态
.dev.vars
.wrangler/
# Terraform：本地 state、provider 缓存与变量文件（可能含 IP 与账号信息）
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.terraform.tfstate.lock.info

*.log
deploy/personal/relay_password.txt
# Workers 中继：构建产物（scripts/build.mjs 生成），只保留 .assetsignore
apps/relay-workers/assets/*
!apps/relay-workers/assets/.assetsignore

# Go 压测（go/bench）的产物
go/bench/bin/
go/bench/results/
go/bench/logs/
go/bench/work/
