// Armadra 中继（Cloudflare Workers）。中继设计 §2、§4.5；部署步骤见 deploy/cloudflare/README.md。
//
// - 只在本仓里描述，**不在这里部署**：`wrangler deploy` / `wrangler secret put` 由维护者在本机执行。
// - 只有生产环境 relay.armadra.com，没有 staging。
// - 按 Workers Free 配置（§4.6 配置 F）：检查周期 120 秒、日配额 8 万次请求。升 Workers Paid 后把
//   RELAY_ALARM_MS 改回 60000、RELAY_DAILY_REQUEST_BUDGET 改成 2000000，并打开 limits.cpu_ms。
// - secret 只经 `wrangler secret put` 录入，这里只列名字（secrets.required）；其余可选 secret 见
//   apps/relay-workers/README.md。
// - 人机挑战（cloud-api §16）：站点密钥（RELAY_TURNSTILE_SITE_KEY，不是秘密）与允许的主机名
//   （RELAY_TURNSTILE_HOSTNAMES）已按环境填好；再
//   `wrangler secret put RELAY_TURNSTILE_SECRET`——录了 secret 才要求挑战；录了 secret 而站点密钥为空
//   是配错，整个 Worker 答 503。RELAY_CHALLENGE_SCOPE 缺省只要求登录（core 接受链接时没有挑战组件）。
// - 拉闸：维护页 Worker 在 wrangler.maintenance.jsonc，`node scripts/kill-switch.mjs` 切换 Custom Domain；
//   区域规则（WAF、限速、DNS、Bot）在 deploy/cloudflare/terraform/。见 docs/runbooks/cloudflare-protection.md。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "armadra-relay",
  "account_id": "a27d9dab9190150768845b62cfd57cfe",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "relay.armadra.com", "custom_domain": true }],
  "rules": [
    { "type": "Text", "globs": ["**/*.sql", "**/*.txt"], "fallthrough": true },
  ],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "durable_objects": {
    "bindings": [
      { "name": "SOURCE", "class_name": "SourceDO" },
      { "name": "CONTROL", "class_name": "ControlDO" },
    ],
  },
  // DO 类只在首版建一次：跨类生命周期的变更不能回滚，之后的 schema 变化全走对象内的迁移账本。
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SourceDO", "ControlDO"] },
  ],
  // §4.2 Worker 内的闸（按 IP，按 Cloudflare 节点各自计数）。
  "ratelimits": [
    {
      "name": "LIMIT_LOGIN",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "LIMIT_LINK_ACCEPT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "LIMIT_REGISTER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "LIMIT_TUNNEL",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "LIMIT_MEDIA",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "LIMIT_ANONYMOUS",
      "namespace_id": "1006",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "LIMIT_PREFLIGHT",
      "namespace_id": "1007",
      "simple": { "limit": 1200, "period": 60 },
    },
  ],
  // Workers Paid：单次调用的 CPU 上限（防失控循环；转发是 I/O 型，正常远低于此）。Free 固定 10 ms、
  // 不能配，先注释；升 Paid 时取消注释。
  // "limits": { "cpu_ms": 5000 },
  "observability": { "logs": { "enabled": true } },
  "vars": {
    "RELAY_MODE": "personal",
    "RELAY_ISSUER": "https://relay.armadra.com",
    "RELAY_HEARTBEAT_MS": "45000",
    "RELAY_ALARM_MS": "120000",
    "RELAY_CLIENT_IDLE_MS": "120000",
    "RELAY_DAILY_REQUEST_BUDGET": "80000",
    "RELAY_DAILY_TUNNEL_BYTES_BUDGET": "53687091200",
    "RELAY_CONTROL_LOCATION": "apac",
    "RELAY_LOG_LEVEL": "info",
    "RELAY_TURNSTILE_SITE_KEY": "0x4AAAAAAFTEevK9h0keZPRh",
    "RELAY_TURNSTILE_HOSTNAMES": "relay.armadra.com",
    "RELAY_CHALLENGE_SCOPE": "auth.login",
  },
  "secrets": { "required": ["RELAY_MASTER_KEY"] },
}
