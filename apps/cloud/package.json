{
  "name": "@armadra/cloud",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Armadra 平台控制面（/v1/*、PostgreSQL、Redis、签名与 JWKS）",
  "bin": {
