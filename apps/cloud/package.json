    "@armadra/control-store-postgres": "workspace:*",
    "@armadra/platform-protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
