# 复制成 .env 再改。口令用 URL 安全的字符（它们会拼进连接串）：openssl rand -hex 24
DOMAIN=example.com
ARMADRA_CLOUD_VERSION=0.0.0
PLATFORM_NAME=Armadra

POSTGRES_PASSWORD=change-me
# 节点的流量角色 armadra_relay_traffic 的口令（db-roles 服务据此建角色，节点据此连库）
RELAY_TRAFFIC_PASSWORD=change-me-too

# 发信（生产）。开发 / 端到端用 compose.mailpit.yml，不需要这些
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=Armadra <no-reply@example.com>
SMTP_TLS=starttls

# 前面的反向代理所在的网段（读 X-Forwarded-For 的受信代理）；缺省是 docker 的私有网段
# TRUSTED_PROXY=172.16.0.0/12
# 托管的 PostgreSQL 时直接给连接串（要 sslmode=verify-full 或 require）
# CLOUD_DATABASE_URL=
