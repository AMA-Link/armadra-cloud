# 复制成 .env 再改；口令与连接串不在这里，由 init-secrets.sh 生成到 secrets/（见 README）
DOMAIN=example.com
ARMADRA_CLOUD_VERSION=0.0.0
PLATFORM_NAME=Armadra

# 发信（生产）。开发 / 端到端用 compose.mailpit.yml，不需要这些；缺了由 serve 校验并警告
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=Armadra <no-reply@example.com>
SMTP_TLS=starttls

# 反向代理在 edge 网络里的固定地址（控制面与节点只信它的 X-Forwarded-For）；网段与地址可按需改
# EDGE_SUBNET=172.29.88.0/24
# PROXY_IP=172.29.88.10
# TRUSTED_PROXY=172.29.88.10/32
