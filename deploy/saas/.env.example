# 复制成 .env 再改；口令与连接串不在这里，由 init-secrets.sh 生成到 secrets/（见 README）
DOMAIN=example.com
ARMADRA_CLOUD_VERSION=0.0.0
PLATFORM_NAME=Armadra

# 发信（生产）。开发 / 端到端用 compose.mailpit.yml，不需要这些；缺了由 serve 校验并警告
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=Armadra <no-reply@example.com>
SMTP_TLS=starttls

# 第三方登录（可选，GitHub / Google）：ID 与密钥文件路径都填了才开；密钥写进 secrets/oauth_github_secret、
# secrets/oauth_google_secret。建应用与回调地址见 docs/runbooks/saas.md「第三方登录」
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET_FILE=/run/secrets/oauth_github_secret
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/oauth_google_secret
# 普通账号的口令登录：on（缺省）或 off；off 时没配任何第三方登录，普通账号就登不进来
# PASSWORD_AUTH=on

# 反向代理在 edge 网络里的固定地址（控制面与节点只信它的 X-Forwarded-For）；网段与地址可按需改
# EDGE_SUBNET=172.29.88.0/24
# PROXY_IP=172.29.88.10
# TRUSTED_PROXY=172.29.88.10/32

# 参考反向代理（--profile proxy）发布的地址与端口；PROXY_BIND 缺省为空，绑全部网卡（IPv4 与 IPv6）的 80 / 443，
# 只给本机用就设 127.0.0.1（IPv6 地址加方括号，如 [::1]）
# PROXY_BIND=127.0.0.1
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443

# 每个服务的 json-file 日志轮转：单个文件上限与保留的文件数（磁盘上每个服务最多约 LOG_MAX_SIZE × LOG_MAX_FILE）
# LOG_MAX_SIZE=20m
# LOG_MAX_FILE=5

# 叠加 compose.metrics.yml 时指标发布到 127.0.0.1 的端口（控制面、节点 a、节点 b）
# CLOUD_METRICS_PORT=9101
# RELAY_A_METRICS_PORT=9102
# RELAY_B_METRICS_PORT=9103

# 推送中继（可选，docker compose --profile push up -d push-relay；镜像随 Armadra v0.12.0 起发布）。
# 封令牌的钥 secrets/push_relay_secret 由 init-secrets.sh 生成；APNs 与 FCM 凭据都是可选的，不填也能启动
# （App 此时只有前台通知）。要开就把 .p8 写进 secrets/push_relay_apns_key、服务账号 JSON 写进
# secrets/push_relay_fcm_credentials，再填下面的变量。参考代理对外的名字是 push.<域>（证书要覆盖它）
# PUSH_RELAY_VERSION=0.12.0
# PUSH_RELAY_PORT=8095
# PUSH_RELAY_APNS_KEY_FILE=/run/secrets/push_relay_apns_key
# PUSH_RELAY_APNS_KEY_ID=
# PUSH_RELAY_APNS_TEAM_ID=
# PUSH_RELAY_APNS_TOPIC=
# PUSH_RELAY_APNS_PRODUCTION=1
# PUSH_RELAY_FCM_CREDENTIALS_FILE=/run/secrets/push_relay_fcm_credentials
# PUSH_RELAY_FCM_PROJECT_ID=
