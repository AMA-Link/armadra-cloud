# 复制成 .env 再改；口令与连接串不在这里，由 init-secrets.sh 生成到 secrets/（见 README）
DOMAIN=example.com
ARMADRA_CLOUD_VERSION=0.0.0
PLATFORM_NAME=Armadra

# 发信（生产）。开发 / 端到端用 compose.mailpit.yml，不需要这些；缺了由 serve 校验并警告
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=Armadra <no-reply@example.com>
SMTP_TLS=starttls

# 反向代理在 edge 网络里的固定地址（控制面与节点只信它的 X-Forwarded-For）；网段与地址可按需改
# EDGE_SUBNET=172.29.88.0/24
# PROXY_IP=172.29.88.10
# TRUSTED_PROXY=172.29.88.10/32

# 参考反向代理（--profile proxy）发布的地址与端口；PROXY_BIND 缺省为空，绑全部网卡（IPv4 与 IPv6）的 80 / 443，
# 只给本机用就设 127.0.0.1（IPv6 地址加方括号，如 [::1]）
# PROXY_BIND=127.0.0.1
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443

# 每个服务的 json-file 日志轮转：单个文件上限与保留的文件数（磁盘上每个服务最多约 LOG_MAX_SIZE × LOG_MAX_FILE）
# LOG_MAX_SIZE=20m
# LOG_MAX_FILE=5

# 叠加 compose.metrics.yml 时指标发布到 127.0.0.1 的端口（控制面、节点 a、节点 b）
# CLOUD_METRICS_PORT=9101
# RELAY_A_METRICS_PORT=9102
# RELAY_B_METRICS_PORT=9103
